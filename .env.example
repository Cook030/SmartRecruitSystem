# Copy to .env and fill blank secrets. Never commit .env.
# Local Go services automatically load the repository .env.
# Process environment overrides .env; config.yaml is optional.

# MySQL (Docker initialization requires a non-root MYSQL_USER)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=smart_recruit
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=
JWT_EXPIRE=24

# gRPC
GRPC_PORT=50051
LOGIC_GRPC_ADDR=127.0.0.1:50051

# Web Service
WEB_PORT=8080

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=

# OSS
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=your-bucket-name

# AI (DeepSeek)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# Cumulative input + output tokens per request (compaction included).
AI_TOKEN_BUDGET=128000

# Frontend ports
HR_FRONTEND_PORT=3001
USER_FRONTEND_PORT=3002
NGINX_PORT=80

# Observability (local services bind management ports to loopback by default)
WEB_METRICS_ADDR=127.0.0.1:9464
LOGIC_METRICS_ADDR=127.0.0.1:9465
# Empty: metrics only. For a local collector, use http://127.0.0.1:4317 (gRPC).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
