      "targets": [
        {
          "expr": "max by (task_type,status) (recruitment_task_oldest_age_seconds{status=~\"pending|retrying\"})",
          "legendFormat": "{{task_type}} {{status}}",
          "refId": "A",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
